{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "ga-ui-plus": ["../packages/ui/src/index.ts"],
      "ga-ui-plus/base": ["../packages/ui/src/base/index.ts"],
      "ga-ui-plus/business": ["../packages/ui/src/business/index.ts"],
      "ga-ui-plus/resolver": ["../packages/ui/src/resolver/index.ts"]
    },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "scripts/**/*.mjs",
    "components.d.ts",
    "vite.config.ts"
  ],
  "exclude": [".vitepress/cache", ".vitepress/dist", ".vitepress/.temp"]
}
