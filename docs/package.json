{
  "name": "ga-ui-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev . --host 0.0.0.0 --port 5557",
    "build": "vitepress build . && pnpm run typecheck",
    "preview": "vitepress preview . --host 0.0.0.0 --port 5557",
    "test": "node --test tests/*.spec.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.3",
    "ga-ui-plus": "workspace:*",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitepress": "^1.6.4",
    "typescript": "5.8.3",
    "vue-tsc": "^3.3.9"
  }
}
